// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  output     = "./generated/client"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id            String          @id @default(uuid())
  name          String
  model         String
  lastImagePath String?
  cameraId      String?
  scheme        AnnotationScheme? @relation(fields: [schemeId], references: [id])
  schemeId      String?
  annotations   Annotation[]
  workflowSteps WorkflowStep[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model AnnotationScheme {
  id          String    @id @default(uuid())
  name        String    @unique
  config      String    // JSON string containing labels, colors, types
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Annotation {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imagePath   String   // The path of the image being annotated
  data        String   // JSON string of all annotation objects for this image
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([imagePath])
}

model DatasetVersion {
  id          String   @id @default(uuid())
  productId   String
  displayName String   @default("")
  versionName String
  moduleName  String   @default("data_augmentation")
  savePath    String
  imageCount  Int
  config      String   // JSON string of augmentation config used
  createdAt   DateTime @default(now())

  @@index([productId])
}

model Camera {
  id              String          @id @default(uuid())
  name            String
  ip              String
  status          String          @default("offline")
  config          String?         // JSON string or additional info
  isEnabled       Boolean         @default(true)
  isNetworkCamera Boolean         @default(false)
  workflowSteps   WorkflowStep[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model TrainingRecord {
  id              String    @id @default(uuid())
  productId       String
  taskUuid        String
  labelName       String
  modelName       String
  config          String
  status          String    @default("pending")
  progress        Float     @default(0)
  totalEpochs     Int?
  currentEpoch    Int?
  batchSize       Int?
  learningRate    Float?
  latestIter      Int?
  metrics         String    @default("[]")
  logs            String    @default("[]")
  startTime       DateTime?
  endTime         DateTime?
  hasBestModel    Boolean   @default(false)
  outputPath      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // 重训相关字段
  isRetrain       Boolean   @default(false)  // 是否是重训任务
  baseTaskUuid    String?   // 基础模型的task_uuid（重训时使用）
  pathId          String?   // 路径ID（重训时使用）
  taskChain       String    @default("")     // 任务血缘链
  generation      Int       @default(0)      // 第几代（0=原始训练，1=第一次重训...）
  fpCount         Int       @default(0)      // Dinomaly False Positive数量
  fnCount         Int       @default(0)      // False Negative数量
  yoloFpCount     Int       @default(0)      // YOLO False Positive数量
  encoderName     String?   // 编码器名称
  decoderDepth    Int?      // 解码器深度
  epochs          Int?      // 训练轮数
  freezeEncoder   Boolean?  // 是否冻结编码器

  @@unique([taskUuid, labelName])
  @@index([productId])
  @@index([taskUuid])
  @@index([status])
  @@index([isRetrain])
  @@index([baseTaskUuid])
}

model AppSettings {
  id            Int      @id @default(1)
  dataPath      String
  locale        String   @default("zh")
  backendMode   String   @default("local")
  backendIp     String   @default("localhost")
  backendUrl    String   @default("http://localhost:8000")
  backendPort   String   @default("8000")
  imageSettings  String?  @default("{\"exposure\":6084,\"gain\":1.2}")
  modbusSettings String?  @default("{\"enabled\":true,\"ip\":\"192.168.1.12\",\"port\":502,\"unitId\":1,\"buttonChannel\":1,\"resetChannel\":2,\"lightGreen\":0,\"lightYellow\":1,\"lightRed\":2,\"buzzer\":3}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ROI 图片记录表 - 用于重训管理
model RoiImage {
  id                String   @id @default(uuid())
  productId         String
  sourceTaskUuid    String   // ROI来源的task_uuid（模型ID）
  category          String   // 缺陷类别

  // 模型原始判断
  modelIsAnomaly    Boolean
  // 用户修正后的判断
  userIsAnomaly     Boolean
  // 检测器来源
  isYoloAnomaly     Boolean  @default(false)  // YOLO检测的异常（false=Dinomaly检测）
  dinomalyScore     Float?   // Dinomaly模型分数
  // 'FP' = False Positive (模型NG, 用户OK) → 用于微调
  // 'FN' = False Negative (模型OK, 用户NG) → 用于原型库
  // 'NORMAL' = 判断一致或用户未修改
  roiType           String   @default("NORMAL")

  filePath          String   // 文件完整路径
  fileName          String   // 文件名
  thumbnailPath     String?  // 缩略图路径

  // 使用状态
  usedInRetrain     Boolean  @default(false)
  usedTaskUuid      String?  // 被用于哪个重训任务
  usedAt            DateTime?

  posId             String?  // 位置ID，用于FN图片的SSIM比对分组

  // 支持链式重训
  generation        Int      @default(0)  // 第几代（0=原始训练，1=第一次重训...）

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productId])
  @@index([sourceTaskUuid])
  @@index([roiType])
  @@index([usedInRetrain])
  @@index([usedTaskUuid])
}

// ========== 识别工作流模型 ==========

model Workflow {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  steps       WorkflowStep[]
  executions  WorkflowExecution[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model WorkflowStep {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  orderIndex  Int                    // 执行顺序 (0, 1, 2...)
  cameraId    String?                // 使用哪个相机拍照
  camera      Camera?  @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  productId   String?                // 使用哪个产品的模型推理
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  timeoutMs   Int      @default(30000)

  @@unique([workflowId, orderIndex])
  @@index([workflowId])
  @@index([cameraId])
  @@index([productId])
}

model WorkflowExecution {
  id          String              @id @default(uuid())
  workflowId  String
  workflow    Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status      String              @default("running")  // running | completed | failed
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  stepResults WorkflowStepResult[]

  @@index([workflowId])
  @@index([status])
}

model WorkflowStepResult {
  id              String            @id @default(uuid())
  executionId     String
  execution       WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepId          String            // FK to WorkflowStep.id
  stepOrderIndex  Int
  cameraId        String?
  productId       String?
  status          String            @default("pending")  // pending | capturing | inferring | completed | failed
  imagePath       String?           // 该步骤拍照保存的图片路径
  inferenceResult String?           // 推理结果 JSON
  isAnomaly       Boolean?          // 该步骤是否检出异常
  anomalyCount    Int?              // 检出缺陷数量
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?

  @@index([executionId])
  @@index([stepId])
}


