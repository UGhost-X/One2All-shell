{
  "appId": "com.one2all.shell",
  "productName": "QH视觉检测平台",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "prisma/schema.prisma",
    "prisma/generated/**/*",
    "prisma/migrations/**/*",
    ".env",
    "package.json",
    "!node_modules/**/test/**",
    "!node_modules/**/tests/**",
    "!node_modules/**/example/**",
    "!node_modules/**/examples/**",
    "!node_modules/**/docs/**",
    "!node_modules/**/*.md",
    "!node_modules/**/*.map",
    "!node_modules/.cache/**",
    "!node_modules/.pnpm/**",
    "!node_modules/.bin/**",
    "!node_modules/**/*.d.ts",
    "!node_modules/**/*.ts",
    "!node_modules/**/LICENSE*",
    "!node_modules/**/license*",
    "!node_modules/**/README*",
    "!node_modules/**/readme*",
    "!node_modules/**/CHANGELOG*",
    "!node_modules/**/HISTORY*",
    "!node_modules/**/.editorconfig",
    "!node_modules/**/.eslintrc*",
    "!node_modules/**/.prettierrc*",
    "!node_modules/**/.gitignore",
    "!node_modules/**/.npmignore",
    "!node_modules/**/package-lock.json",
    "!node_modules/**/yarn.lock",
    "!node_modules/**/tsconfig.json",
    "!**/*.map",
    "!**/.git",
    "!**/.github",
    "!**/dist",
    "!**/build",
    "!**/test",
    "!**/tests",
    "!**/docs",
    "!**/log",
    "!**/logs",
    "!prisma/dev.db"
  ],
  "asar": true,
  "asarUnpack": [
    "prisma/generated/**/*",
    "prisma/dev.db"
  ],
  "extraResources": [
    {
      "from": "prisma/generated",
      "to": "prisma/generated"
    },
    {
      "from": "prisma/dev.db",
      "to": "prisma/dev.db"
    },
    {
      "from": "renderer/.output/public",
      "to": "renderer/.output/public"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "renderer/public/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "compression": "normal",
  "includePdb": false
}
